# 사이트 URL (배포 후 실제 도메인으로 변경, SMS API route 호출/SEO에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (프로젝트 설정 > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 토스페이먼츠
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# 네이버클라우드 SENS (문자 발송)
NCP_SENS_SERVICE_ID=ncp:sms:kr:xxxxxxxxxxxx:dentjob
NCP_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
NCP_SECRET_KEY=xxxxxxxxxxxxxxxxxxxx
NCP_SENDER_PHONE=0212345678

# Anthropic Claude API (AI 이력서/자기소개서/공고 초안 생성) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 카카오 (지도, 공유하기) — https://developers.kakao.com 앱 등록 후 JavaScript 키 발급
NEXT_PUBLIC_KAKAO_JS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 카카오 알림톡 (비즈메시지 대행사, 예: Solapi/NHN Toast — 카카오톡 채널·템플릿 승인 필요)
KAKAO_ALIMTALK_PROVIDER_API_KEY=
KAKAO_ALIMTALK_PROVIDER_API_SECRET=
KAKAO_ALIMTALK_SENDER_KEY=
KAKAO_ALIMTALK_TEMPLATE_APPLY=
KAKAO_ALIMTALK_TEMPLATE_STATUS=
